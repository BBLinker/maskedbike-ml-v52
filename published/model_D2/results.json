{
  "config": {
    "data_contract": {
      "adc_source": "clkgen_x4",
      "cycle_origin": "each share interval start; matching positions determine period only and never rotate a share",
      "cycle_samples": "largest uniform window that stays inside every share interval, capped at j stride",
      "j_count": 14,
      "j_stride_samples": "infer from the constant stride of matching_j_positions",
      "masking_order": 2,
      "rounds": {
        "labeled_negative": 0,
        "labeled_positive": 7,
        "unlabeled_adaptation": 2
      },
      "samples": "read and verify from each run manifest",
      "share_count": 3,
      "share_count_rule": "q = masking_order + 1",
      "share_intervals": "read and verify from each run manifest"
    },
    "evaluation": {
      "independent_round": 2,
      "metrics": [
        "roc_auc",
        "pr_auc",
        "balanced_accuracy",
        "macro_f1",
        "mcc",
        "confusion_matrix"
      ],
      "negative_truth": "hamming_weight != 0",
      "positive_truth": "hamming_weight == 0"
    },
    "experiment": "masking-order-2-centered-product-cscae",
    "model": {
      "channels": 8,
      "classifier_widths": [
        256,
        128,
        64,
        32
      ],
      "cscae_input_channels": 1,
      "input": "normalized q-share centered product [j,time]",
      "latent_ratio": 0.1,
      "output_classes": 2
    },
    "outputs": [
      "bundle-audit.json",
      "artifact-manifest.json",
      "dataset-snapshot.json",
      "preprocessing.npz",
      "model.pt",
      "predictions.npz",
      "results.json"
    ],
    "preprocessing": {
      "alignment_max_shift": 4,
      "alignment_stride": 2,
      "centered_product": "pointwise product over all 3 centered shares at identical [j,time]",
      "centering": "training-only mean at every [share,j,time]",
      "clip_percentile": 99.9,
      "one_global_shift_per_trace": true,
      "pooling": false
    },
    "profiling": {
      "expected_traces_per_bundle": 100,
      "r0_bundles": 300,
      "r2_bundles": 200,
      "r7_bundles": 300
    },
    "schema": "maskedbike-qshare-semisupervised-config.v2",
    "seed": 8888,
    "split": {
      "group_keys": [
        "bundle_id",
        "case_id",
        "trace_id"
      ],
      "strategy": "chronological_complete_bundles",
      "train_fraction": 0.7,
      "validation_fraction": 0.3
    },
    "training": {
      "autoencoder_data": "R0 + unlabeled R2 + R7 profiling partitions",
      "autoencoder_epochs": 30,
      "autoencoder_selection": "validation reconstruction MSE",
      "auxiliary_reconstruction_weight": 0.05,
      "batch_size": 512,
      "classifier_data": "labeled R0 and R7 only",
      "classifier_epochs": 100,
      "classifier_selection": "R0/R7 validation ROC-AUC",
      "early_stopping_patience": 20,
      "gradient_clip_norm": 1.0,
      "learning_rate": 0.001,
      "noise_std": 0.03,
      "threshold_selection": "maximize balanced accuracy on R0/R7 validation only",
      "weight_decay": 1e-05
    }
  },
